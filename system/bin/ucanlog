#!/system/bin/sh
# ucanlog - collect diagnostics for bug reports.
# Needs root for the full report. Output: /sdcard/UcanLog (override with UCANLOG_OUT).

VERSION="1.0.0"
OUT_BASE="${UCANLOG_OUT:-/sdcard/UcanLog}"
MODULES_DIR="${UCANLOG_MODULES_DIR:-/data/adb/modules}"
DO_LOGCAT=1
DO_DMESG=1

say() { echo "[ucanlog] $*"; }

usage() {
  cat <<USAGE
ucanlog $VERSION - collect diagnostics for bug reports

Usage: ucanlog [options]
  --no-logcat   do not include logcat
  --no-dmesg    do not include the kernel log
  -v, --version show version
  -h, --help    show this help

Output goes to $OUT_BASE
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-logcat) DO_LOGCAT=0 ;;
    --no-dmesg) DO_DMESG=0 ;;
    -v|--version) echo "ucanlog $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

has() { command -v "$1" >/dev/null 2>&1; }

STAMP="$(date +%Y%m%d-%H%M%S)"
NAME="ucanlog-$STAMP"
WORK="$OUT_BASE/$NAME"

mkdir -p "$WORK" || { say "Cannot create $WORK"; exit 1; }

if [ "$(id -u)" != "0" ]; then
  say "Not running as root. The report will be incomplete (use: su -c ucanlog)."
fi

# 1. Device
{
  echo "ucanlog $VERSION"
  echo "date: $(date)"
  for key in ro.product.manufacturer ro.product.model ro.product.device ro.build.version.release \
             ro.build.version.sdk ro.build.version.security_patch ro.build.fingerprint ro.product.cpu.abi; do
    echo "$key: $(getprop "$key" 2>/dev/null)"
  done
  echo "kernel: $(uname -a 2>/dev/null)"
  has getenforce && echo "selinux: $(getenforce 2>/dev/null)"
} > "$WORK/device.txt" 2>&1

# 2. Root solution (only reports what can be seen, nothing is guessed)
{
  if has magisk; then
    echo "magisk: $(magisk -v 2>/dev/null) ($(magisk -V 2>/dev/null))"
  fi
  [ -d /data/adb/ksu ] && echo "KernelSU data directory present"
  [ -d /data/adb/ap ] && echo "APatch data directory present"
  [ -d /data/adb/magisk ] && echo "Magisk data directory present"
  echo "(nothing listed above means nothing was detected or access was denied)"
} > "$WORK/root.txt" 2>&1

# 3. Installed modules
{
  if [ -d "$MODULES_DIR" ]; then
    for dir in "$MODULES_DIR"/*/; do
      [ -f "${dir}module.prop" ] || continue
      id=$(grep -m1 '^id=' "${dir}module.prop" | cut -d= -f2-)
      mname=$(grep -m1 '^name=' "${dir}module.prop" | cut -d= -f2-)
      mver=$(grep -m1 '^version=' "${dir}module.prop" | cut -d= -f2-)
      state="enabled"
      [ -f "${dir}disable" ] && state="disabled"
      [ -f "${dir}remove" ] && state="pending removal"
      echo "$id | $mname | $mver | $state"
    done
  else
    echo "Cannot read $MODULES_DIR (root needed)."
  fi
} > "$WORK/modules.txt" 2>&1

# 4. Logs
if [ "$DO_LOGCAT" = "1" ]; then
  if has logcat; then
    logcat -b all -d -v threadtime > "$WORK/logcat.txt" 2>&1 || logcat -d > "$WORK/logcat.txt" 2>&1
  else
    echo "logcat not available" > "$WORK/logcat.txt"
  fi
fi
if [ "$DO_DMESG" = "1" ]; then
  if has dmesg; then dmesg > "$WORK/dmesg.txt" 2>&1; else echo "dmesg not available" > "$WORK/dmesg.txt"; fi
fi

# 5. Pack
RESULT="$WORK"
if has tar && tar -czf "$WORK.tar.gz" -C "$OUT_BASE" "$NAME" 2>/dev/null; then
  rm -rf "$WORK"
  RESULT="$WORK.tar.gz"
fi

say "Saved: $RESULT"
say "Privacy: logs can contain account names and device identifiers. Review before sharing."
exit 0
